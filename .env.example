# Environment Variables Configuration
# Copy this file to .env and set your own values

# Encryption key for securing sensitive data (32+ characters recommended)
# Generate a strong key: openssl rand -hex 32
# WARNING: Keep this key secret and secure! Never commit it to version control.
ENCRYPTION_SECRET_KEY=your-super-secure-32-plus-character-encryption-key-here-change-this

# Database Configuration
MONGO_URI=your-mongodb-connection-string

# JWT Secret for authentication
JWT_SECRET=your-jwt-secret-key

# Server Configuration
PORT=5000